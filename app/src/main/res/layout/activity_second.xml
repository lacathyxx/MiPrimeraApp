<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/received_text"
            android:textColor="?attr/colorPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/text_received_from_another_application"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textRecibido"
                android:layout_width="match_parent"
                android:hint="@string/shared_text_will_appear_here"
                android:layout_height="wrap_content"
                android:minHeight="96dp"
                android:padding="20dp"
                android:textIsSelectable="true"
                android:textSize="18sp"
                android:lineSpacingExtra="4dp" />

        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnCompartirDeNuevo"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:text="@string/share_again"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            app:backgroundTint="?attr/colorPrimary" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>